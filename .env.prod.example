# 部署示例：复制为 .env.prod 并填入真实值（不要提交到任何公开仓库）
# 站点 A（论坛 A）
SOURCE_URL=https://forum-a.example.com/thread0806.php?fid=16
FEED_TITLE=论坛 A 示例订阅
# 站点 B（论坛 B）
FORUM_B_BASE_URL=https://forum-b.example.com
FORUM_B_INDEX_URL=https://forum-b.example.com/index.php
# 对外地址
PUBLIC_FEED_URL=https://rss.example.com/rss.xml
PUBLIC_BASE_URL=https://rss.example.com
# 精华快照（论坛 A）
SNAPSHOT_BASE_URL=https://forum-a.example.com/thread0806.php?fid=16&search=digest&page={page}
SNAPSHOT_PUBLIC_URL=https://rss.example.com/rss/caoliu-digest.xml
SNAPSHOT_OUTPUT=/var/rss-feed/caoliu-digest.xml
# 服务
BIND_HOST=0.0.0.0
PORT=28888
CACHE_SECONDS=600
FAILURE_RETRY_SECONDS=60
MIN_FETCH_INTERVAL_SECONDS=10
REQUEST_TIMEOUT_SECONDS=20
MAX_FEED_ITEMS=100
USER_AGENT=ForumRSSBot/1.0 (+private feed reader)
KEEP_IMAGE_POSTS_ONLY=1
